{
  "name": "@crystal/core",
  "version": "2.0.0-alpha.1",
  "description": "Crystal design system: tokens, material primitives, headless core, icons and specifications.",
  "scripts": {
    "build:motion": "node tools/build-motion.cjs",
    "test": "node tools/build-tokens.cjs && node tools/build-catalogue.cjs && node tests/core-contracts.cjs && node tools/validate-tokens.cjs && node tools/validate-motion.cjs && python3 tests/visual-gate-contracts.py && node tools/validate-docs.cjs",
    "build:tokens": "node tools/build-tokens.cjs",
    "build:catalogue": "node tools/build-catalogue.cjs",
    "build": "node tools/build-tokens.cjs && node tools/build-catalogue.cjs && node tools/build-icons.cjs",
    "capture:frames": "node tools/capture-frames.mjs",
    "verify:visual": "node tools/verify-frames.mjs",
    "verify:floor": "node tools/verify-frames.mjs --no-webgl",
    "audit:materials": "node tools/audit-materials.mjs",
    "verify:interactions": "node tools/verify-interactions.mjs",
    "validate:docs": "node tools/validate-docs.cjs"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "gsap": "3.15.0",
    "motion": "13.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide-static": "^1.47.0",
    "playwright": "^1.63.0"
  },
  "private": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boomerbowser/crystal.git",
    "directory": "design-system"
  },
  "files": [
    "assets/",
    "tokens/",
    "exports/",
    "docs/",
    "reference/licenses/",
    "README.md",
    "src/"
  ],
  "exports": {
    ".": "./exports/crystal-tokens.ts",
    "./tokens": "./tokens/crystal.tokens.json",
    "./css": "./assets/crystal.css",
    "./theme": "./assets/crystal-theme.css",
    "./controls": "./assets/controls.css",
    "./core": {
      "types": "./assets/core/state.d.ts",
      "default": "./assets/core/state.js"
    },
    "./icons": "./assets/icons/manifest.json",
    "./core/state": {
      "types": "./assets/core/state.d.ts",
      "default": "./assets/core/state.js"
    },
    "./core/preferences": {
      "types": "./assets/core/preferences.d.ts",
      "default": "./assets/core/preferences.js"
    },
    "./core/spring": "./assets/core/spring.js",
    "./motion-recipes": "./tokens/motion-recipes.json",
    "./engines": "./src/engines.js",
    "./shaders/": "./assets/shaders/",
    "./flat": "./tokens/crystal.json",
    "./core/presets": {
      "types": "./assets/core/presets.d.ts",
      "default": "./assets/core/presets.js"
    },
    "./catalogue": "./tokens/catalogue.json"
  }
}
